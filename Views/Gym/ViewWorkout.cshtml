@model GymTime.Models.Workout

<h2>@Model.WorkoutName</h2>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Reps</th>
        <th>Sets</th>
        <th>PR</th>
        <th>Description</th>
    </tr>
    <tr>
        <td>@Model.Id</td>
        <td>@Model.WorkoutName</td>
        <td>@Model.Reps</td>
        <td>@Model.Sets</td>
        <td>@Model.PersonalRecord</td>
        <td>@Model.Description</td>
    </tr>
</table>

<div style="margin-top: 15px;">
    <a asp-controller="Gym"
       asp-action="UpdateWorkout"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit Workout
    </a>
</div>

<div style="margin-top: 10px;">
    <form asp-controller="Gym"
          asp-action="DeleteWorkout"
          method="post"
          onsubmit="return confirm('Are you sure you want to delete this workout?');">

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete Workout
        </button>
    </form>
</div>

<div style="margin-top: 15px;">
    <a asp-controller="Gym" asp-action="Index">Back to Dashboard</a>
</div>
