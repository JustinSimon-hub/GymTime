@model GymTime.Models.GymViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<!-- Macro Tracker -->
<div class="p-3 mb-4" style="background:var(--gt-surface);border:1px solid var(--gt-border);border-radius:6px;">
    <h5 class="mb-3">Macros</h5>
    <div class="row align-items-center">
        <div class="col-md-5">
            <div style="max-width:280px;margin:0 auto;">
                <canvas id="heartChart"></canvas>
            </div>
        </div>
        <div class="col-md-7">
            <table class="table table-sm table-borderless mb-0" style="color:var(--gt-text);">
                <tr><td>Protein</td><td class="text-end"><span id="totalProteins">0</span> g</td></tr>
                <tr><td>Carbs</td><td class="text-end"><span id="totalCarbs">0</span> g</td></tr>
                <tr><td>Fat</td><td class="text-end"><span id="totalFats">0</span> g</td></tr>
                <tr><td>Calories</td><td class="text-end"><span id="totalCalories">0</span> kcal</td></tr>
            </table>
        </div>
    </div>
</div>

<!-- Diet Section -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Diet</h5>
    <a href="/Gym/InsertDiet/" class="btn btn-sm btn-outline-light">+ Add food</a>
</div>
<div class="p-3 mb-4" style="background:var(--gt-surface);border:1px solid var(--gt-border);border-radius:6px;">
    @if (Model.Diets.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="color:var(--gt-text);">
                <thead>
                    <tr>
                        <th>Food</th>
                        <th>Protein</th>
                        <th>Fat</th>
                        <th>Carbs</th>
                        <th>Calories</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var diet in Model.Diets)
                    {
                        <tr>
                            <td>@diet.FoodName</td>
                            <td>@diet.Proteins g</td>
                            <td>@diet.Fats g</td>
                            <td>@diet.Carbohydrates g</td>
                            <td>@diet.Calories kcal</td>
                            <td><a href="/Gym/ViewDiet/@diet.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No diet entries yet. <a href="/Gym/InsertDiet/">Add one</a>.</p>
    }
</div>

<!-- Workout Section -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Workouts</h5>
    <a href="/Gym/InsertWorkout/" class="btn btn-sm btn-outline-light">+ Add workout</a>
</div>
<div class="p-3 mb-4" style="background:var(--gt-surface);border:1px solid var(--gt-border);border-radius:6px;">
    @if (Model.Workouts.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="color:var(--gt-text);">
                <thead>
                    <tr>
                        <th>Exercise</th>
                        <th>Reps</th>
                        <th>Sets</th>
                        <th>PR</th>
                        <th>Notes</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.Workouts)
                    {
                        <tr>
                            <td>@w.WorkoutName</td>
                            <td>@w.Reps</td>
                            <td>@w.Sets</td>
                            <td>@w.PersonalRecord lbs</td>
                            <td>@w.Description</td>
                            <td><a href="/Gym/ViewWorkout/@w.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No workouts yet. <a href="/Gym/InsertWorkout/">Log one</a>.</p>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        fetch('/Gym/GetMacroData')
            .then(r => r.json())
            .then(data => {
                document.getElementById('totalProteins').innerText = data.totalProteins;
                document.getElementById('totalCarbs').innerText = data.totalCarbs;
                document.getElementById('totalFats').innerText = data.totalFats;
                document.getElementById('totalCalories').innerText = data.totalCalories;

                new Chart(document.getElementById('heartChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Protein', 'Carbs', 'Fat'],
                        datasets: [{
                            data: [data.totalProteins, data.totalCarbs, data.totalFats],
                            backgroundColor: ['#e05263', '#4ea8de', '#e6c74c'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        cutout: '60%',
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { color: '#ccc', padding: 12, font: { size: 13 } }
                            }
                        }
                    }
                });
            });
    </script>
}
