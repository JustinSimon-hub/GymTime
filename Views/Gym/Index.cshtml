@model IEnumerable<GymTime.Models.Diet>

<h2>Diet Plans</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Food name</th>
        <th>Protien</th>
        <th>Carbohyrdates</th>
        <th>Calories</th>
      
    </tr>

    @foreach (var diet in Model)
    {
        <tr>
            <td><a href=/Gym/ViewDiet/@diet.Id>@diet.Id</a></td>
            <td>@diet.FoodName</td>
            <td>@diet.Proteins</td>
            <td>@diet.Carbohyradates</td>
            <td>@diet.Calories</td>
        </tr>

    }
</table>
