@model IEnumerable<GymTime.Models.Diet>

<h2>Diet Plans</h2>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var diet in Model)
        {
            <tr>
                <td>@diet.FoodName</td>
                <td>@diet.Calories</td>
                <td>@diet.Proteins</td>
                <td>@diet.Fats</td>
                <td>@diet.Carbohyradates</td>
            </tr>
        }

    </tbody>
</table>
