@model GymTime.Models.Workout

<h2>Edit Workout</h2>

<form asp-controller="Gym" asp-action="UpdateWorkoutToDatabase" method="post">

    <!-- Required -->
    <input type="hidden" asp-for="Id" />

    <!-- UserId intentionally NOT in the form -->

    <div class="form-group">
        <label asp-for="WorkoutName"></label>
        <input asp-for="WorkoutName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Reps"></label>
        <input asp-for="Reps" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Sets"></label>
        <input asp-for="Sets" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PersonalRecord"></label>
        <input asp-for="PersonalRecord" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Update Workout
    </button>
</form>

<div>
    <a asp-controller="Gym" asp-action="Index">Back to Dashboard</a>
</div>
