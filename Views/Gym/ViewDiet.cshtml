@model Diet

<h2>@Model.FoodName</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Food Name</th>
        <th>Protein</th>
        <th>Carbohydrates</th>
        <th>Fats</th>
        <th>Calories</th>
    </tr>
    <tr>
        <td>@Model.Id</td>
        <td>@Model.FoodName</td>
        <td>@Model.Proteins</td>
        <td>@Model.Carbohydrates</td>
        <td>@Model.Fats</td>
        <td>@Model.Calories</td>
    </tr>
</table>

<div style="margin-top: 15px;">
    <a asp-controller="Gym"
       asp-action="UpdateDiet"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit Diet
    </a>
</div>

<div style="margin-top: 10px;">
    <form asp-controller="Gym"
          asp-action="DeleteDiet"
          method="post"
          onsubmit="return confirm('Are you sure you want to delete this diet?');">

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete Diet
        </button>
    </form>
</div>

<div style="margin-top: 15px;">
    <a asp-controller="Gym" asp-action="Index">Back to Dashboard</a>
</div>
