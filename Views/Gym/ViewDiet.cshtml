@model Diet
<h2>@Model.FoodName</h2>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Food name</th>
        <th>Protien</th>
        <th>Carbohyrdates</th>
        <th>Fats</th>
        <th>Calories</th>

    </tr>

    
        <tr>
        <td>@Model.Id</td>
        <td>@Model.FoodName</td>
        <td>@Model.Proteins</td>
        <td>@Model.Carbohydrates</td>
        <td>@Model.Fats</td>
        <td>@Model.Calories</td>
       
        </tr>

    
</table>
<div style="display: block">
    <a asp-controller="Gym"
       asp-action="UpdateDiet"
       asp-route-id="@Model.Id">
        Update this food
    </a>
</div>


<div style="display: block; margin-top: 10px;">
    <form asp-controller="Gym"
          asp-action="DeleteDiet"
          method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete this food
        </button>
    </form>
</div>
