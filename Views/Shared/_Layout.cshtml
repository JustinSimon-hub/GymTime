<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GymTime</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --gt-bg: #121212;
            --gt-surface: #1e1e1e;
            --gt-border: #2a2a2a;
            --gt-accent: #4ea8de;
            --gt-text: #e0e0e0;
            --gt-muted: #888;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--gt-bg);
            color: var(--gt-text);
            min-height: 100vh;
        }

        .navbar {
            background-color: var(--gt-surface) !important;
            border-bottom: 1px solid var(--gt-border);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--gt-accent) !important;
            letter-spacing: -0.5px;
        }

        .nav-link { color: var(--gt-muted) !important; }
        .nav-link:hover { color: var(--gt-text) !important; }

        .main-container {
            max-width: 960px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        footer {
            border-top: 1px solid var(--gt-border);
            color: var(--gt-muted);
            font-size: 0.85rem;
            padding: 1.5rem 0;
            text-align: center;
            margin-top: 3rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid" style="max-width:960px;margin:0 auto;">
            <a class="navbar-brand" asp-controller="Gym" asp-action="Index">GymTime</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gym" asp-action="Index">Dashboard</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">Log out</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Sign up</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <p class="mb-0">&copy; 2025 GymTime</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
